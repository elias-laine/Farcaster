# ============================================
# Backend Environment Variables
# ============================================

# Neynar API Key (get from https://neynar.com)
NEYNAR_API_KEY=

# Signer Private Key (for signing mint transactions)
# IMPORTANT: Keep this secret! Use a test key only
SIGNER_PRIVATE_KEY=

# Task Configuration
CAST_HASH=
TARGET_FID=

# Contract Addresses
CONTRACT_ADDRESS=
VITE_CONTRACT_ADDRESS=

# Blockchain Configuration
CHAIN_ID=8453
VITE_CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
VITE_RPC_URL=https://mainnet.base.org

# ============================================
# Frontend Environment Variables (VITE_)
# ============================================

VITE_CAST_URL=
VITE_TARGET_USERNAME=
VITE_CHAIN_NAME=Base
VITE_EXPLORER_URL=https://basescan.org

# ============================================
# Development Settings
# ============================================

NODE_ENV=development
PORT=5000
